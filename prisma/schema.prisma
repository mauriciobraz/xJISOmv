generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @unique @default(uuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Wallets Wallet[]
}

model Wallet {
  id String @id @unique @default(uuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId   String
  tickerId String

  User   User   @relation(fields: [userId], references: [id])
  Ticker Ticker @relation(fields: [tickerId], references: [id])

  Transactions Transaction[]

  @@unique([userId, tickerId])
}

model Ticker {
  id String @id @unique @default(uuid())

  /// Image/SVG URL for the logo for this currency.
  ///
  /// @example https://example.com/tron.svg
  displayLogo String

  /// Display name in english for this currency.
  ///
  /// @example USDT (Tether)
  displayName String

  /// Unique crypto currency identifier.
  ///
  /// @example TRC20_USDT
  slug String @unique

  Wallets Wallet[]

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Transaction {
  id String @id @unique @default(uuid())

  /// Address generated by CryptAPI.
  addressIn String?

  /// Addresses where the funds will be sent.
  addressOut String?

  /// Address used by the user to add the funds.
  addressUser String?

  /// Amount in the native crypto currency received.
  amountUser Float?

  /// Callback URL containing all required metadata, e.g.:
  ///
  /// @example https://example.com/api/callback/confirm?__s=96eef343b50c
  callbackUrl String?

  /// Unique ID for each callback request, used to identify duplicated callback
  /// calls, this should be set as soon the first request is received and processed.
  callbackId String? @unique

  walletId String

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  Status TransactionStatus @default(Pending)
  Wallet Wallet            @relation(fields: [walletId], references: [id])
}

enum TransactionStatus {
  /// The transaction failed to process.
  Failed

  /// The transaction is pending user payment.
  Pending

  /// The transaction is currently being processed.
  Confirming

  /// The transaction has been completed successfully.
  Successful
}
