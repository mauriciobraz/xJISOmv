datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model Session {
  id String @id @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  active_expires BigInt
  idle_expires   BigInt
  user_id        String

  user User @relation(references: [id], fields: [user_id], onDelete: Cascade)

  @@index([user_id])
}

model Key {
  id String @id @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hashed_password String?
  user_id         String

  user User @relation(references: [id], fields: [user_id], onDelete: Cascade)

  @@index([user_id])
}

model User {
  id String @id @unique @default(uuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  key           Key[]
  wallets       Wallet[]
  auth_sessions Session[]

  username      String @unique
  password_hash String

  // NOT IMPLEMENTED YET
  two_factor_secret String?
  two_factor_method String?
}

model Wallet {
  id String @id @unique @default(uuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId   String
  tickerId String

  user   User   @relation(fields: [userId], references: [id])
  ticker Ticker @relation(fields: [tickerId], references: [id])

  transactions Transaction[]

  @@unique([userId, tickerId])
}

model Ticker {
  id String @id @unique @default(uuid())

  /// Image/SVG URL for the logo for this currency.
  ///
  /// @example https://example.com/tron.svg
  displayLogo String

  /// Display name in english for this currency.
  ///
  /// @example USDT (Tether)
  displayName String

  /// Unique crypto currency identifier.
  ///
  /// @example TRC20_USDT
  slug String @unique

  wallets Wallet[]

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Transaction {
  id String @id @unique @default(uuid())

  /// Address generated by CryptAPI.
  addressIn String?

  /// Addresses where the funds will be sent.
  addressOut String?

  /// Address used by the user to add the funds.
  addressUser String?

  /// Amount in the native crypto currency received.
  amountUser Float?

  /// Callback URL containing all required metadata, e.g.:
  ///
  /// @example https://example.com/api/callback/confirm?__s=96eef343b50c
  callbackUrl String?

  /// Unique ID for each callback request, used to identify duplicated callback
  /// calls, this should be set as soon the first request is received and processed.
  callbackId String? @unique

  walletId String

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  status String
  wallet Wallet @relation(fields: [walletId], references: [id])
}
