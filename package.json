    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/eslint": "^9.6.0",
    "@types/insane": "^1.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.36.0",
    "fluid-tailwind": "^1.0.3",
    "globals": "^15.0.0",
    "lucia": "^3.2.0",
